+#define RH_ARC          3u
+
+static bool
+rh_arc_level_ok(uint32_t aux_off, uint32_t aux_len, unsigned level)
+{
+	for (uint32_t i = 0; i + 2 <= aux_len; i += 2) {
+		if (rh_db16(aux_off + i) == level) {
+			return true;
+		}
+	}
+	return false;
+}
+
+int
+sweet_rpmh_arc_vote(const char *res, unsigned level)
+{
+	/* GPU bring-up helper: only CX/GFX ARC, SVS or lower, never retention/off. */
+	if (!res || (strcmp(res, "cx.lvl") && strcmp(res, "gfx.lvl")) ||
+		level < 0x40 || level > 0x80) {
+		printf("SWEET RPMH: ARC vote allows cx.lvl/gfx.lvl at 0x40..0x80 only\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, aux_off = 0, aux_len = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address, RH_ARC, &aux_off, &aux_len);
+	}
+	if (!error && !rh_arc_level_ok(aux_off, aux_len, level)) {
+		printf("SWEET RPMH: %s has no level %#x in cmd-db\n", res, level);
+		error = EINVAL;
+	}
+	if (!error) {
+		const uint32_t offsets[1] = {0};
+		const uint32_t values[1] = {level};
+		error = rh_send(address, offsets, values, 1);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: ARC vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
