+	static bool shadow_tried;
+	static uint64_t rows_copied, rows_skipped, presents;
+	size_t shadow_size = (size_t)fRowBytes * fHeight;
+
+	if (fShadow == NULL && !shadow_tried) {
+		shadow_tried = true;
+		fShadow = (uint8_t *)IOMallocData(shadow_size);
+		IOLog("SWEET FB: row-diff shadow %s (%lu bytes)\n",
+			fShadow ? "ok" : "alloc FAILED", (unsigned long)shadow_size);
+	}
+	if (fShadow != NULL && !fShadowValid) {
+		memcpy(fShadow, (const void *)fPixels, shadow_size);
